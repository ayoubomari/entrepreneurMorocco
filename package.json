{
  "name": "my-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
    "test": "vitest",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:generate": "drizzle-kit generate",
    "db:reset": "npx supabase db reset",
    "db:migrate": "npx supabase db push --include-all",
    "db:new-migration": "npx supabase migration new",
    "db:types": "npx supabase gen types typescript --project-id fbvzjlifpnpdbcbypypz > types/database.ts",
    "db:deploy": "npx supabase db push --include-all && npm run db:types"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.91.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.37.0",
    "libphonenumber-js": "^1.12.34",
    "lucide-react": "^0.534.0",
    "next": "15.4.5",
    "postgres": "^3.4.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.71.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.19.37",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.17"
  }
}
